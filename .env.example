# Copy to `.env` and fill in real values — never commit the filled file.
# Generate secrets:  openssl rand -base64 48

# --- Database (docker-compose.yml and docker-compose.prod.yml) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=shopsphere_user
MYSQL_PASSWORD=change-me-app

# --- Auth (REQUIRED) ---
JWT_SECRET_KEY=generate-a-long-random-secret
JWT_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Production only (docker-compose.prod.yml + Caddyfile) ---
# Free subdomain from duckdns.org, pointing at the server's public IP.
PUBLIC_DOMAIN=shopsphere-demo.duckdns.org
# On the server, also set:
#   CORS_ALLOWED_ORIGINS=https://shopsphere-demo.duckdns.org
#   JWT_COOKIE_SECURE=true

# --- Razorpay (optional; TEST mode keys from the dashboard) ---
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Mail ---
MAIL_CONSOLE_FALLBACK=true
MAIL_FROM=noreply@shopsphere.local
