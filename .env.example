# Template for `docker compose --env-file .env.example up --build`.
# COPY to `.env` and fill in real values — never commit the filled file.
# Generate a JWT secret:  openssl rand -base64 64

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=shopsphere_user
MYSQL_PASSWORD=change-me-app

# 512-bit random secret — REQUIRED
JWT_SECRET_KEY=generate-a-long-random-secret
JWT_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Razorpay TEST mode keys (dashboard → Settings → API Keys → Test)
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

MAIL_CONSOLE_FALLBACK=true
MAIL_FROM=noreply@shopsphere.local
