# Copy to `.env` and fill in real values — never commit the filled file.
# Generate secrets:  openssl rand -base64 48

# --- Database (docker-compose.yml and docker-compose.prod.yml) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=shopsphere_user
MYSQL_PASSWORD=change-me-app

# --- Auth (REQUIRED) ---
JWT_SECRET_KEY=generate-a-long-random-secret
JWT_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Production only (docker-compose.prod.yml + Caddyfile) ---
# Free subdomain from duckdns.org, pointing at the server's public IP.
PUBLIC_DOMAIN=shopsphere-demo.duckdns.org
# On the server, also set:
#   CORS_ALLOWED_ORIGINS=https://shopsphere-demo.duckdns.org
#   JWT_COOKIE_SECURE=true

# --- Razorpay (optional; TEST mode keys from the dashboard) ---
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- YouPI PG self-hosted UPI (optional; experimental upstream project) ---
# YouPI runs as a separate Node service (default API port 6100, checkout 7000).
# In Docker the backend reaches a gateway running on the Docker host through
# host.docker.internal (extra_hosts is configured in both compose files). For a
# real deployment prefer a private network/VPN address and never publish the
# merchant API port to the internet.
# The merchant key + webhook secret stay server-side; only checkoutUrl is sent
# to the browser. Rotate the key via YouPI's admin API before first use.
YOUPI_ENABLED=false
YOUPI_BASE_URL=http://host.docker.internal:6100
YOUPI_MERCHANT_ID=
YOUPI_MERCHANT_KEY=
YOUPI_WEBHOOK_SECRET=
# Storefront origin used for returnUrl. It must exactly match the origin
# allowlisted in YouPI's YOUPI_ALLOWED_RETURN_ORIGINS.
YOUPI_RETURN_BASE_URL=https://shopsphere-demo.duckdns.org
# On the YouPI gateway process, also set:
#   YOUPI_ALLOWED_RETURN_ORIGINS=https://shopsphere-demo.duckdns.org
#   YOUPI_ALLOWED_ORIGINS=https://shopsphere-demo.duckdns.org

# --- Mail ---
MAIL_CONSOLE_FALLBACK=true
MAIL_FROM=noreply@shopsphere.local
