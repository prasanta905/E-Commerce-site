          }
        },
        {
          "name": "Admin All Coupons",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/coupons",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "coupons"]
            }
          }
        }
      ]
    }
  ]
}
