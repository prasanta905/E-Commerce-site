        {
          "name": "Admin Restock / Adjust Stock",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"delta\": 25,\n  \"reason\": \"Supplier batch restock\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/inventory/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "inventory", "1"]
