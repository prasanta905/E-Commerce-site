              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "orders"]
            }
          }
        },
        {
          "name": "Admin All Customers",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/customers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "customers"]
            }
          }
        },
        {
          "name": "Admin Inventory Stock List",
          "request": {
            "method": "GET",
            "header": [
